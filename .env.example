# Optional host port overrides; defaults work without copying this file.
DEV_PORT=5173
HTTP_PORT=8080
RUST_LOG=info,tower_http=debug
# Origins must match exposed ports; do not share this key/credentials with a public environment.
ROOT_DOMAIN=ici.localhost
# For make dev; use http://ici.localhost:8080 for make up.
# PUBLIC_ORIGIN=http://ici.localhost:5173
MAILPIT_PORT=8025
# REGISTRY_KEY=<64 hexadecimal characters, generated per real environment>
# CENTRAL_DATABASE_URL=postgres://ici_registry:<password>@postgres/ici
# PROVISIONER_DATABASE_URL=postgres://postgres:<password>@postgres/ici
# TENANT_DATABASE_BASE_URL=postgres://postgres@postgres/ici
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_FROM=Ici <noreply@example.com>
# SMTP_USERNAME=<smtp username>
# SMTP_PASSWORD=<smtp password>
